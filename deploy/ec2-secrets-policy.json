{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PortfolioAgentSecretOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:ai-trading-bot/integrated-portfolio-*"
    }
  ]
}
