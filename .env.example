# Copy this file to .env (next to this file, or one folder up) and fill in the two keys marked REQUIRED. Never commit .env.
#
# Every setting the bot reads is listed here. Lines starting with "# NAME=value" show the DEFAULT: uncomment and change a
# line only to override it. Percentages are fractions (0.05 = 5%). tests/test_env_example.py fails if this file drifts
# from the code, so what you read here is what runs.

# ============================================================ REQUIRED: the AI (OpenRouter)
# https://openrouter.ai/settings/keys - the free ":free" models cost nothing but are rate-limited and sometimes withdrawn.
# Models are tried in this order, then the built-in list (nex-agi/nex-n2.5-pro:free) as a last resort.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODEL=dots-studio/dots-3-note-preview:free

# ============================================================ Optional: Telegram alerts and /status /positions /pause /resume /rebase
# Create a bot with @BotFather, message it once from a PRIVATE chat, then put the token and your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================ Market and universe
# NSE stocks, Yahoo data, built-in paper-trading simulator: no broker keys needed. India is the only market.
# MARKET=india
# UNIVERSE=market             # market = scan the whole exchange (~2,300 stocks); watchlist = only WATCHLIST
# WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
# MAX_CANDIDATES=15           # scanner survivors (best 12-1 month momentum) that get the AI analysis
# MIN_PRICE=100               # rupees
# MIN_TRADED_VALUE=100000000  # minimum average daily value traded: Rs 10 crore
# MAX_DAILY_VOLATILITY=0.04
# DELIVERY_FILTER=false       # true = only above-median 20-day NSE delivery %; needs bhavcopy files saved by hand daily
# NSE_FILES_DIR=nse_files     # NSE files you download in a browser (stock list, index lists, daily bhavcopy); see README

# ============================================================ Paper account, position sizing and risk limits
# PAPER_INITIAL_CASH=1000000  # starting balance in rupees. Read once, when the paper account is first created.
# MAX_OPEN_POSITIONS=10
# MIN_POSITION_PCT=0.05       # position size at MIN_CONFIDENCE; set below MAX_POSITION_PCT to scale size with confidence
# MAX_POSITION_PCT=0.05       # position size at confidence 1.0 (the flat size when the two are equal)
# MAX_PORTFOLIO_EXPOSURE_PCT=0.80
# MAX_DAILY_LOSS_PCT=0.02     # new buys halt for the day at this loss
# MAX_DRAWDOWN_PCT=0.20       # new buys halt when equity is this far below its peak...
# DRAWDOWN_PAUSE_DAYS=30      # ...and resume (peak rebased) after this many days; 0 = only recovery or /rebase ends it
# MAX_FEE_DRAG_PCT=0.04       # refuse a buy whose round-trip fees exceed this share of the position (tiny positions); 0 = off
# MIN_CONFIDENCE=0.60         # the AI's confidence must reach this to trade
# REBUY_COOLDOWN_HOURS=24
# CASH_YIELD_PCT=0.0          # annual rate idle paper cash earns (a liquid mutual fund sweep); 0 = off. The bot is ~45% invested

# ============================================================ Exits
# STOP_LOSS_PCT=0.15          # protective stop, a safety net (2% and 8% were too tight; see STRATEGY.md)
# TAKE_PROFIT_PCT=1.00        # effectively no target: winners run until the trend exit
# TREND_EXIT=true             # sell a held stock when its last completed close is below its 200-day average
# AUTO_PROTECT=true           # place a protective stop on any live position found without one

# ============================================================ AI behaviour
# LLM_COT=true                # five-step chain-of-thought stored with each decision; false = the old one-line prompt
# LLM_REFLECT=true            # a critic that can VETO a call (BUY -> HOLD); it never lowers the confidence of a call it upholds
# LLM_LEARNING=true           # adjust calls from how similar setups turned out across ALL analysed stocks (silent until LEARNING_MIN_SAMPLES outcomes exist)
# LLM_CONTEXT=true            # adjust when the market regime is notable (index stress / euphoria)
#                             # On the free models, context is best left OFF (=false) until an ablation shows it helps: it adds an AI call
#                             # per stock and has not shown value. Learning costs a call only once the memory has enough evidence.
# LLM_MAX_ADJUST=0.15         # largest confidence change one refinement phase may make
# LEARNING_HORIZON=60         # sessions an outcome is measured over when the bot learns how similar setups turned out (5, 20 or 60)
# LEARNING_MIN_SAMPLES=30     # independent observations a setup needs before the memory says anything (below: silent)
# LEARNING_SEED=false         # true: the memory also uses setups rebuilt from price history (scripts/seed_setup_memory.py),
#                             # so it speaks before months of live outcomes exist. Review its report first: history has survivorship bias
# LLM_TEMPERATURE=0           # 0 = the model's most likely answer every time (the same bar was answered HOLD, then BUY, at the default)
# LLM_CACHE_HOURS=12          # reuse identical AI answers; 0 disables
# LLM_REASONING_OFF=true      # the free models "think" in hidden tokens that eat the budget: off = valid answers 3-10x faster
# LLM_MIN_INTERVAL=3.0        # seconds between AI requests (the free tier allows ~20 a minute)
# LLM_CONCURRENCY=2           # AI requests in flight at once; 0 = unlimited
# ANALYSIS_WORKERS=3          # stocks analysed at once (lower it if the free tier rate-limits you)

# ============================================================ Operation
# DRY_RUN=true                # true = record decisions only; false (or the --live flag) = place paper orders
# DATABASE_URL=sqlite:///trading.db
# INTRADAY_DATABASE_URL=sqlite:///intraday.db   # the intraday engine's own paper account

# ============================================================ Intraday engine (own paper account; sized by risk, cash only)
# A position is the smaller of: the stop-out costs INTRADAY_RISK_PCT of equity, and INTRADAY_MAX_POSITION_PCT of equity.
# A stock whose single share costs more than the position cap is skipped, and the skip is recorded (table intraday_signals).
# INTRADAY_RISK_PCT=0.005         # equity risked per trade if the stop is hit
# INTRADAY_MAX_POSITION_PCT=0.20  # largest position as a fraction of equity
# INTRADAY_MAX_POSITIONS=5        # open at once; positions x cap cannot exceed 100% (no leverage)
# INTRADAY_UNIVERSE=              # comma list of symbols to scan; empty = Nifty 100 file if saved, else Yahoo's top 100 by traded value
# INTRADAY_ARCHIVE=true           # save each finished session's 5-minute bars (Yahoo keeps ~60 sessions): the history for testing rules
# LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text             # text | json (the Docker image uses json)

# ============================================================ Real-portfolio agent (src/portfolio; read-only)
# Where your Integrated login (mobile/MPIN/customer ID) is stored. "keyring" = Windows Credential Manager, on your
# own PC. "aws" = one encrypted secret in AWS Secrets Manager, for the AWS deployment (no Windows Credential Manager
# there); needs boto3 and an IAM role/user allowed secretsmanager:GetSecretValue/PutSecretValue/CreateSecret/DeleteSecret.
# PORTFOLIO_SECRET_BACKEND=keyring
# PORTFOLIO_SECRET_NAME=ai-trading-bot/integrated-portfolio   # the secret's name, only used by the aws backend
# PORTFOLIO_NO_SANDBOX=false  # true inside a container (the AWS deployment): trades Chromium's OS sandbox, which
#                             # needs a capability containers don't have, for Docker's own isolation instead
