# Copy this file to .env and fill in real values. Never commit .env.

# --- Required for every market ---
# OpenRouter (https://openrouter.ai/settings/keys) - free models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODEL=dots-studio/dots-3-note-preview:free

# --- Market ---
# india (default): NSE stocks, Yahoo data, built-in paper-trading simulator, no broker keys needed.
# us: US stocks via Alpaca paper trading (needs the two Alpaca keys below).
MARKET=india

# --- Only for MARKET=us ---
# Alpaca paper trading (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Optional: Telegram alerts + /status /positions /pause /resume ---
# Create a bot with @BotFather, message it once from a PRIVATE chat, then put the token and your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional tuning (defaults shown; percentages are fractions, e.g. 0.05 = 5%) ---
# UNIVERSE=market             # market = scan the whole exchange; watchlist = only WATCHLIST
# WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
# MAX_CANDIDATES=15           # scan survivors that get the AI analysis
# MIN_PRICE=100               # India default (US: 10), in local currency
# MIN_TRADED_VALUE=100000000  # min average daily value traded: Rs 10 crore (US: 20000000)
# MAX_DAILY_VOLATILITY=0.04
# MAX_POSITION_PCT=0.05
# MAX_PORTFOLIO_EXPOSURE_PCT=0.80
# MAX_OPEN_POSITIONS=10
# MAX_DAILY_LOSS_PCT=0.02
# MAX_DRAWDOWN_PCT=0.20
# MIN_CONFIDENCE=0.60
# STOP_LOSS_PCT=0.08          # protective stop; the original 2% was stopped out by daily noise (see STRATEGY.md)
# TAKE_PROFIT_PCT=1.00        # effectively no target; winners run until the trend exit
# REBUY_COOLDOWN_HOURS=24
# PAPER_INITIAL_CASH=1000000  # India paper account starting balance (Rs)
# ANALYSIS_WORKERS=3          # stocks analysed concurrently (lower it if the free AI tier rate-limits you)
# LLM_CACHE_HOURS=12          # reuse identical AI answers; 0 disables
# DRY_RUN=false               # same as --live (paper orders)
# AUTO_PROTECT=true           # place a protective stop on any live position found without one
# LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text             # text | json (docker uses json)
# DATA_FEED=sip               # US only: use iex if your Alpaca plan rejects sip
# TREND_EXIT=true            # sell a held stock when its last completed close is below its 200-day average
