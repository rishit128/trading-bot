# Copy this file to .env and fill in real values. Never commit .env.

# --- Required for every market ---
# OpenRouter (https://openrouter.ai/settings/keys) - free models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODEL=dots-studio/dots-3-note-preview:free

# --- Market ---
# NSE stocks, Yahoo data, built-in paper-trading simulator, no broker keys needed.
MARKET=india

# --- Optional: Telegram alerts + /status /positions /pause /resume ---
# Create a bot with @BotFather, message it once from a PRIVATE chat, then put the token and your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional tuning (defaults shown; percentages are fractions, e.g. 0.05 = 5%) ---
# UNIVERSE=market             # market = scan the whole exchange; watchlist = only WATCHLIST
# WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
# MAX_CANDIDATES=15           # scan survivors that get the AI analysis
# MIN_PRICE=100               # India default (US: 10), in local currency
# MIN_TRADED_VALUE=100000000  # min average daily value traded: Rs 10 crore (US: 20000000)
# MAX_DAILY_VOLATILITY=0.04
# MAX_POSITION_PCT=0.05
# MAX_PORTFOLIO_EXPOSURE_PCT=0.80
# MAX_OPEN_POSITIONS=10
# MAX_DAILY_LOSS_PCT=0.02
# MAX_DRAWDOWN_PCT=0.20
# DRAWDOWN_PAUSE_DAYS=30      # buying resumes (peak rebased) this many days after the drawdown halt; 0 = never by itself
# MIN_CONFIDENCE=0.60
# STOP_LOSS_PCT=0.15          # protective stop (safety net; the MA200 trend exit is the real exit). 2% and 8% were too tight (see STRATEGY.md)
# TAKE_PROFIT_PCT=1.00        # effectively no target; winners run until the trend exit
# REBUY_COOLDOWN_HOURS=24
# PAPER_INITIAL_CASH=1000000  # India paper account starting balance (Rs)
# ANALYSIS_WORKERS=3          # stocks analysed concurrently (lower it if the free AI tier rate-limits you)
# LLM_CACHE_HOURS=12          # reuse identical AI answers; 0 disables
# LLM_COT=true               # chain-of-thought reasoning stored with each decision; false restores the one-line prompt
# LLM_LEARNING=true          # phase 2: adjust calls from the closed paper-trade record of similar setups
# LLM_CONTEXT=true           # phase 3: adjust when the market regime is notable (index stress / euphoria); the index/VIX
#                            #   data is fetched from Yahoo and cached under research_cache on first use
# LLM_REFLECT=true           # phase 4: self-critique of the assembled call (extra LLM call per actionable signal)
# LLM_MAX_ADJUST=0.15        # largest confidence change one refinement phase may make (single-call cap, 0-1)
# DRY_RUN=false               # same as --live (paper orders)
# AUTO_PROTECT=true           # place a protective stop on any live position found without one
# LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text             # text | json (docker uses json)
# TREND_EXIT=true            # sell a held stock when its last completed close is below its 200-day average
# DELIVERY_FILTER=true        # candidates need above-median 20-day NSE delivery %; unproven, single 3-year test (STRATEGY.md)
# MIN_POSITION_PCT=0.05       # position size at the minimum confidence; set below MAX_POSITION_PCT to scale by confidence
# MAX_POSITION_PCT=0.05       # position size at confidence 1.0 (also the flat size when MIN_POSITION_PCT is unset)
